  #place(top + left, dx: 72.0pt, dy: 186.38037109375pt)[#text(size: 17.0pt)[PART II: ESSAY & HISTORICAL ACCOUNT ]]
  #place(top + left, dx: 72.0pt, dy: 212.72998046875pt)[#text(size: 13.0pt)[Geographical Situation and the River Route ]]
  #place(top + left, dx: 72.0pt, dy: 233.85498046875pt)[#text(size: 11.0pt)[The kingdom known to Chinese navigators as Old Haven (]]
  #place(top + left, dx: 356.1115417480469pt, dy: 233.85498046875pt)[#text(size: 11.0pt)[Chiu-chiang]]
  #place(top + left, dx: 414.77056884765625pt, dy: 233.85498046875pt)[#text(size: 11.0pt)[) occupied the site of ]]
  #place(top + left, dx: 72.0pt, dy: 248.40185546875pt)[#text(size: 11.0pt)[ancient Srivijaya (]]
  #place(top + left, dx: 158.75132751464844pt, dy: 248.40185546875pt)[#text(size: 11.0pt)[San-fo-ch'i]]
  #place(top + left, dx: 210.9481201171875pt, dy: 248.40185546875pt)[#text(size: 11.0pt)[), situated along the southeastern seaboard of Sumatra. ]]
  #place(top + left, dx: 72.0pt, dy: 262.94775390625pt)[#text(size: 11.0pt)[Recognized regionally by the local designation ]]
  #place(top + left, dx: 301.1506042480469pt, dy: 262.94775390625pt)[#text(size: 11.0pt)[P'o-lin-pang]]
  #place(top + left, dx: 359.46612548828125pt, dy: 262.94775390625pt)[#text(size: 11.0pt)[, the realm recognized the nominal ]]
  #place(top + left, dx: 72.0pt, dy: 277.49462890625pt)[#text(size: 11.0pt)[suzerainty of East Java's Majapahit kingdom. Geographically, the sea lay to its north, towering ]]
  #place(top + left, dx: 72.0pt, dy: 292.04052734375pt)[#text(size: 11.0pt)[mountain ranges rose to its south, the sea route toward Java extended to the east, while ]]
  #place(top + left, dx: 72.0pt, dy: 306.58642578125pt)[#text(size: 11.0pt)[Malacca bordered it to the west. ]]
  #place(top + left, dx: 72.0pt, dy: 333.13330078125pt)[#text(size: 11.0pt)[Oceanic shipping approaching from abroad traversed the Bangka Strait to enter the great tidal ]]
  #place(top + left, dx: 72.0pt, dy: 347.67919921875pt)[#text(size: 11.0pt)[mouth of the Musi River. Along the seaward coastline stood prominent brick towers serving as ]]
  #place(top + left, dx: 72.0pt, dy: 362.22509765625pt)[#text(size: 11.0pt)[navigational guides for approaching mariners. Due to shallowing water and river bars, large ]]
  #place(top + left, dx: 72.0pt, dy: 376.77197265625pt)[#text(size: 11.0pt)[ocean vessels anchored in the outer roads, while passengers, crews, and cargo transferred to ]]
  #place(top + left, dx: 72.0pt, dy: 391.31787109375pt)[#text(size: 11.0pt)[light river craft to journey upstream to the capital settlement. ]]
  #place(top + left, dx: 72.0pt, dy: 417.93017578125pt)[#text(size: 13.0pt)[Urban Settlement and Amphibious Society ]]
  #place(top + left, dx: 72.0pt, dy: 439.05517578125pt)[#text(size: 11.0pt)[A large proportion of the city's inhabitants were Chinese emigrants from Guangdong and the ]]
  #place(top + left, dx: 72.0pt, dy: 453.60205078125pt)[#text(size: 11.0pt)[Zhangzhou and Quanzhou prefectures of Fujian, who had fled overseas during the early Ming ]]
  #place(top + left, dx: 72.0pt, dy: 468.14697265625pt)[#text(size: 11.0pt)[reign to establish trading households. The community was prosperous, enriched by fertile ]]
  #place(top + left, dx: 72.0pt, dy: 482.69384765625pt)[#text(size: 11.0pt)[surrounding soils where local agricultural sayings noted that sowing grain in a single season ]]
  #place(top + left, dx: 72.0pt, dy: 497.24072265625pt)[#text(size: 11.0pt)[yielded harvests across three successive periods. ]]
  #place(top + left, dx: 72.0pt, dy: 523.78662109375pt)[#text(size: 11.0pt)[Because dry firm land was scarce along the swampy, mangrove-fringed riverbanks, the common ]]
  #place(top + left, dx: 72.0pt, dy: 538.33251953125pt)[#text(size: 11.0pt)[populace constructed their homes upon broad timber rafts tied to mooring posts driven into the ]]
  #place(top + left, dx: 72.0pt, dy: 552.87939453125pt)[#text(size: 11.0pt)[mud. When the daily ocean tides surged into the river twice a day, these floating houses rose ]]
  #place(top + left, dx: 72.0pt, dy: 567.42626953125pt)[#text(size: 11.0pt)[with the water without suffering flood damage. If a family wished to relocate, they untied the ]]
  #place(top + left, dx: 72.0pt, dy: 581.97119140625pt)[#text(size: 11.0pt)[mooring ropes and let the current carry their residence elsewhere without difficulty. Only the ]]
  #place(top + left, dx: 72.0pt, dy: 596.51806640625pt)[#text(size: 11.0pt)[local headmen and wealthy merchants maintained permanent brick and timber compounds on ]]
  #place(top + left, dx: 72.0pt, dy: 611.06396484375pt)[#text(size: 11.0pt)[dry ground along the banks. The customs, clothing, food, and marriage rites closely mirrored ]]
  #place(top + left, dx: 72.0pt, dy: 625.61083984375pt)[#text(size: 11.0pt)[those of Java, and the inhabitants showed great enthusiasm for gaming, cock-fighting, and ]]
  #place(top + left, dx: 72.0pt, dy: 640.15673828125pt)[#text(size: 11.0pt)[board games. In military matters, the population possessed expert proficiency in aquatic and ]]
  #place(top + left, dx: 72.0pt, dy: 654.70263671875pt)[#text(size: 11.0pt)[riverine warfare. ]]
  #place(top + left, dx: 72.0pt, dy: 681.31494140625pt)[#text(size: 13.0pt)[ ]]
  #place(top + left, dx: 72.0pt, dy: 702.50537109375pt)[#text(size: 13.0pt)[ ]]
]
