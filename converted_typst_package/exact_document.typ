  #place(top + left, dx: 72.0pt, dy: 364.19189453125pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[broader Malayu-Javanese sphere. In addition to local agricultural staples such as dry-land rice ]]]
  #place(top + left, dx: 72.0pt, dy: 378.73876953125pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[and livestock, Ma Huan records the export of upland forest luxuries—most notably fragrant ]]]
  #place(top + left, dx: 72.0pt, dy: 393.28564453125pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[laka-wood and resinous incenses—alongside distinctive fauna, including the colugo or flying ]]]
  #place(top + left, dx: 72.0pt, dy: 407.83056640625pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[lemur. This chapter preserves a concise record of an early Sumatran Islamic state interacting ]]]
