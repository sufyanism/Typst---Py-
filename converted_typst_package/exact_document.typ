  #place(top + left, dx: 102.2362289428711pt, dy: 72.75244140625pt)[#text(size: 23.0pt)[The Country of Man-la-chia \[Malacca\] ]]
  #place(top + left, dx: 89.25769805908203pt, dy: 108.83935546875pt)[#text(size: 13.0pt)[An Account of the Strait Emporium from the Ying-yai Sheng-lan (1433) ]]
  #place(top + left, dx: 283.0978088378906pt, dy: 129.96630859375pt)[#text(size: 11.0pt)[Ma Huan ]]
  #place(top + left, dx: 72.0pt, dy: 156.51220703125pt)[#text(size: 11.0pt)[Translated by J. V. G. Mills · Edited by Feng Ch'eng-chün ]]
  #place(top + left, dx: 72.0pt, dy: 183.25439453125pt)[#text(size: 17.0pt)[PART I: CRITICAL APPARATUS ]]
  #place(top + left, dx: 72.0pt, dy: 209.60498046875pt)[#text(size: 13.0pt)[1. Contextual Headnote ]]
  #place(top + left, dx: 72.0pt, dy: 230.72998046875pt)[#text(size: 11.0pt)[During the early fifteenth century, the rise of the Melaka Sultanate transformed regional ]]
  #place(top + left, dx: 72.0pt, dy: 245.27587890625pt)[#text(size: 11.0pt)[navigation and commerce across maritime Southeast Asia. Prior to its imperial elevation, the ]]
  #place(top + left, dx: 72.0pt, dy: 259.82177734375pt)[#text(size: 11.0pt)[settlement—known in early Chinese records as the Five Islands (]]
  #place(top + left, dx: 388.47088623046875pt, dy: 259.82177734375pt)[#text(size: 11.0pt)[Wu-hsü]]
  #place(top + left, dx: 426.3424072265625pt, dy: 259.82177734375pt)[#text(size: 11.0pt)[)—was a subordinate ]]
  #place(top + left, dx: 72.0pt, dy: 274.36962890625pt)[#text(size: 11.0pt)[coastal territory forced to pay tribute under threat of invasion from Ayutthaya. In 1409, during the ]]
  #place(top + left, dx: 72.0pt, dy: 288.91455078125pt)[#text(size: 11.0pt)[third expedition of Admiral Zheng Ho, the Ming court formally elevated Malacca to the status of ]]
  #place(top + left, dx: 72.0pt, dy: 303.46142578125pt)[#text(size: 11.0pt)[an independent kingdom, conferring royal regalia, official seals, and a stone inscription upon its ]]
  #place(top + left, dx: 72.0pt, dy: 318.00830078125pt)[#text(size: 11.0pt)[founder, Parameswara (later Sultan Iskandar Shah). Ma Huan’s account provides an essential ]]
  #place(top + left, dx: 72.0pt, dy: 332.55419921875pt)[#text(size: 11.0pt)[view of this strategic port city at the height of the Ming tributary relationship. He details the ]]
  #place(top + left, dx: 72.0pt, dy: 347.10009765625pt)[#text(size: 11.0pt)[establishment of a fortified Chinese cantonment (]]
  #place(top + left, dx: 310.9029541015625pt, dy: 347.10009765625pt)[#text(size: 11.0pt)[kuan-ch'ang]]
  #place(top + left, dx: 370.4475402832031pt, dy: 347.10009765625pt)[#text(size: 11.0pt)[) that served as a central logistics ]]
  #place(top + left, dx: 72.0pt, dy: 361.64599609375pt)[#text(size: 11.0pt)[base, transshipment storehouse, and rendezvous depot for treasure fleets dispersing across the ]]
  #place(top + left, dx: 72.0pt, dy: 376.19189453125pt)[#text(size: 11.0pt)[Indian Ocean and assembling for the return voyage. Ma Huan also documents the emergence ]]
  #place(top + left, dx: 72.0pt, dy: 390.73876953125pt)[#text(size: 11.0pt)[of Islamic institutions, riverine marketplace infrastructure, indigenous tin-block currencies, forest ]]
  #place(top + left, dx: 72.0pt, dy: 405.28564453125pt)[#text(size: 11.0pt)[resources, and regional fauna. ]]
  #place(top + left, dx: 72.0pt, dy: 431.89599609375pt)[#text(size: 13.0pt)[2. Dramatis Personae ]]
  #place(top + left, dx: 90.0pt, dy: 453.02294921875pt)[#text(size: 11.0pt)[●​]]
  #place(top + left, dx: 99.69732666015625pt, dy: 453.02294921875pt)[#text(size: 11.0pt)[ ]]
  #place(top + left, dx: 108.0pt, dy: 453.02294921875pt)[#text(size: 11.0pt)[Ma Huan (fl. 1413–1451):]]
  #place(top + left, dx: 235.6822052001953pt, dy: 453.02294921875pt)[#text(size: 11.0pt)[ Official interpreter, Chinese Muslim scholar from Shaoxing, ]]
