  #place(top + left, dx: 293.16949462890625pt, dy: 262.46728515625pt)[#text(size: 11.0pt)[ or "Old Haven" by Chinese navigators) served as ]]
  #place(top + left, dx: 72.0pt, dy: 277.01318359375pt)[#text(size: 11.0pt)[a vital strategic station linking the Java Sea with the Strait of Malacca. Originally the seat of the ]]
  #place(top + left, dx: 72.0pt, dy: 291.56005859375pt)[#text(size: 11.0pt)[once-dominant Buddhist maritime thalassocracy of Srivijaya (]]
