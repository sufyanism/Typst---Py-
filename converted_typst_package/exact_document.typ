  #place(top + left, dx: 72.0pt, dy: 247.92138671875pt)[#text(size: 11.0pt)[During the early fifteenth-century voyages commanded by Grand Eunuch Zheng Ho, the Musi ]]
  #place(top + left, dx: 72.0pt, dy: 262.46728515625pt)[#text(size: 11.0pt)[River port of Palembang (termed ]]
