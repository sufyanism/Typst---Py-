  #place(top + left, dx: 72.0pt, dy: 262.36962890625pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[represented an important regional coastal polity along the Strait of Malacca. Situated between ]]]
  #place(top + left, dx: 72.0pt, dy: 276.91455078125pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[the rising commercial power of Malacca to the east and the major regional hub of ]]]
  #place(top + left, dx: 72.0pt, dy: 291.46142578125pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[Semudera-Pasai to the west, Aru provided Ming navigators with an accessible riverine ]]]
  #place(top + left, dx: 72.0pt, dy: 306.00830078125pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[anchorage along the eastern Sumatran coastline. As an official interpreter serving aboard the ]]]
  #place(top + left, dx: 72.0pt, dy: 320.55517578125pt)[#text(size: 11.0pt)[#text(fill: rgb("1f1f1f"))[treasure fleet, Ma Huan documented the small kingdom’s geographical setting, social ]]]
